# Copy this file to .env and fill in the real values locally.
# Never commit the .env file.
BOT_TOKEN=
AI_API_KEY=

# Optional settings
ADMIN_ID=
RATE_LIMIT_REQUESTS_PER_MINUTE=40

# Optional: secret token for the Telegram webhook (Render/production).
# If set, Telegram must send it in the X-Telegram-Bot-Api-Secret-Token header.
TELEGRAM_WEBHOOK_SECRET=
